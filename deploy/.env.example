# Copy to .env on the production server: cp .env.example .env

# Frontend origin(s) allowed to hit https://sign.3100.kz from a browser.
# This is the value Caddy doesn't touch — the signer's Javalin CORS plugin uses it.
#
# Examples:
#   ALLOWED_ORIGIN=https://3100.kz
#   ALLOWED_ORIGIN=https://app.3100.kz
#   ALLOWED_ORIGIN=*                   # any origin (NOT recommended for production)
#
# If you need to allow multiple subdomains, the simplest path is to set this to *
# and add an explicit allowlist in the Caddyfile instead (more flexible, supports
# wildcards correctly).
ALLOWED_ORIGIN=https://3100.kz
